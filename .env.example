# ─────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copiar a .env y completar con valores reales.
# El .env NUNCA se sube a git (ver .gitignore). Solo vive en local y en el servidor.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# ── PostgreSQL (lo consume docker-compose) ──────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── API (NestJS) ────────────────────────────────────────
NODE_ENV=
PORT=
# Local (app fuera de Docker):  postgresql://USER:PASS@localhost:5432/DB?schema=public
# Prod (app dentro de Docker):  postgresql://USER:PASS@postgres:5432/DB?schema=public
DATABASE_URL=
JWT_SECRET=
WEB_ORIGIN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── Web (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=

# ── pgAdmin (SOLO local, no se usa en producción) ───────
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
